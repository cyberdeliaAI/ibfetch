{
  "name": "ibfetch-desktop",
  "productName": "ibfetch",
  "version": "1.2.1",
  "description": "Download selected iBroadcast music in a standalone desktop window.",
  "author": "Cyberdelia",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "pack": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "nl.cyberdelia.ibfetch",
    "executableName": "ibfetch",
    "asar": true,
    "directories": {
      "output": "out"
    },
    "files": [
      "*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/backend/ibfetch-server",
        "to": "backend"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../docs/THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../build/licenses",
        "to": "licenses"
      }
    ],
    "afterPack": "./harden.cjs",
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "../build/assets/ibfetch.icns",
      "category": "public.app-category.music",
      "identity": "-"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "../build/assets/ibfetch.ico"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "icon": "../build/assets/ibfetch.png",
      "category": "Audio"
    }
  }
}
